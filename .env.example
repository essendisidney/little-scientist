# Little Scientist — environment variables
# Copy to `.env.local` for local dev. Set the same keys in Vercel → Project → Settings → Environment Variables.

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://littlescientist.ke

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (optional — enquiry + ticket confirmations) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@littlescientist.ke
INFO_EMAIL=info@littlescientist.ke

# ── Payments: KCB BUNI (production) ────────────────────────────────────────
PAYMENT_PROVIDER=kcb
KCB_ENVIRONMENT=production
KCB_CLIENT_ID=
KCB_CLIENT_SECRET=
KCB_TOKEN_URL=https://api.buni.kcbgroup.com/token?grant_type=client_credentials
KCB_MPESA_EXPRESS_URL=https://api.buni.kcbgroup.com/mm/api/request/1.0.0/stkpush
KCB_CALLBACK_URL=https://littlescientist.ke/api/kcb/mpesa/callback
KCB_SHARED_SHORT_CODE=true
KCB_INVOICE_BRAND=LITTLESCIENTIST
KCB_ACCOUNT_NUMBER=8068418

# ── Payments: Safaricom Daraja (fallback / legacy) ───────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://littlescientist.ke/api/mpesa/callback

# ── Ops / cron ───────────────────────────────────────────────────────────────
# Vercel Cron sends: Authorization: Bearer {CRON_SECRET}
CRON_SECRET=
